# Generated by $generated_by for app "$app_id". Do not edit in the app repo;
# change deploy/templates/deployed.toml.tmpl or the install parameters and regenerate.
# Secrets come from the Data App's secrets: #ACCESS_STORAGE_TOKEN and #MASK_SALT
# (not #KBC_TOKEN: the runtime sets KBC_TOKEN itself and skips a secret of that name).

[identity]
# Set by the Keboola apps-proxy from the OIDC claims (email, groups).
email_header = "X-Kbc-User-Email"
roles_header = "X-Kbc-User-Roles"
roles_separator = "$roles_separator"
trusted_prefix = "x-kbc-"
hostile_headers = ["x-forwarded-email", "x-forwarded-user", "x-forwarded-groups", "x-auth-request-email", "x-user-email", "remote-user"]

[providers.entra]
label = "Microsoft Entra ID"
group_id_pattern = "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$$"
example = "3f2b8c1e-7d4a-4e5b-9a61-2c8d0f4e1b7a"

[providers.okta]
label = "Okta"
group_id_pattern = "^00g[0-9A-Za-z]{17}$$"
example = "00g1a2b3c4d5e6f7g8h9"

[store]
backend = "keboola"

[store.keboola]
stack_url = "$stack_url"
bucket_id = "$bucket_id"
http_timeout_seconds = 30
job_timeout_seconds = 120
job_poll_seconds = 1
# Control-plane tables are read whole; a table this big is refused, not truncated.
preview_row_limit = 1000
# One admin page reads the tables several times; reuse a read for this long (writes read fresh).
read_cache_seconds = 5

[ui]
# oauth2-proxy sign-out behind the Keboola apps-proxy; the next visit asks the IdP again.
switch_user_path = "/_proxy/sign_out"

[gate]
# Each ACL read is five Storage API calls; a revoked grant takes effect within this window.
cache_ttl_seconds = 30

[audit]
path = "logs/audit.jsonl"
tail_lines = 200

[logging]
path = "logs/app.log"
level = "INFO"

[discovery]
http_timeout_seconds = 30
data_apps_component_id = "keboola.data-apps"
$data_block$apps_block
